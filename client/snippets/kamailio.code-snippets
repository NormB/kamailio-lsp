{
  "Request route": {
    "prefix": "request_route",
    "body": ["request_route {", "\t$0", "}"],
    "description": "Main SIP request routing block"
  },
  "Named route": {
    "prefix": "route",
    "body": ["route[${1:NAME}] {", "\t$0", "}"],
    "description": "Named route block"
  },
  "Failure route": {
    "prefix": "failure_route",
    "body": ["failure_route[${1:NAME}] {", "\t$0", "}"],
    "description": "Failure route block (armed with t_on_failure)"
  },
  "Reply route": {
    "prefix": "onreply_route",
    "body": ["onreply_route[${1:NAME}] {", "\t$0", "}"],
    "description": "Reply route block (armed with t_on_reply)"
  },
  "Branch route": {
    "prefix": "branch_route",
    "body": ["branch_route[${1:NAME}] {", "\t$0", "}"],
    "description": "Branch route block (armed with t_on_branch)"
  },
  "Event route": {
    "prefix": "event_route",
    "body": ["event_route[${1:module:event}] {", "\t$0", "}"],
    "description": "Event route block"
  },
  "Onsend route": {
    "prefix": "onsend_route",
    "body": ["onsend_route {", "\t$0", "}"],
    "description": "Onsend route block"
  },
  "Load module": {
    "prefix": "loadmodule",
    "body": ["loadmodule \"${1:module}.so\""],
    "description": "Load a module"
  },
  "Module parameter": {
    "prefix": "modparam",
    "body": ["modparam(\"${1:module}\", \"${2:parameter}\", ${3:value})"],
    "description": "Set a module parameter"
  },
  "Define": {
    "prefix": "define",
    "body": ["#!define ${1:NAME} ${2:value}"],
    "description": "Preprocessor define"
  },
  "Ifdef block": {
    "prefix": "ifdef",
    "body": ["#!ifdef ${1:NAME}", "$0", "#!endif"],
    "description": "Preprocessor conditional block"
  },
  "If method": {
    "prefix": "ifmethod",
    "body": ["if (is_method(\"${1:INVITE}\")) {", "\t$0", "}"],
    "description": "Branch on the SIP method"
  },
  "If/else": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "If/else block"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "While loop"
  },
  "Switch": {
    "prefix": "switch",
    "body": ["switch (${1:\\$rU}) {", "\tcase \"${2:value}\":", "\t\t$0", "\t\tbreak;", "\tdefault:", "\t\tbreak;", "}"],
    "description": "Switch on a value"
  },
  "Log line": {
    "prefix": "xlog",
    "body": ["xlog(\"L_${1|INFO,NOTICE,WARN,ERR,DBG|}\", \"${2:message}\\n\");"],
    "description": "Log a message"
  },
  "Send reply": {
    "prefix": "sl_send_reply",
    "body": ["sl_send_reply(\"${1:200}\", \"${2:OK}\");"],
    "description": "Send a stateless reply (sl module)"
  }
}
